{
  "name": "@local/dsh-atpet",
  "version": "1.0.0",
  "private": true,
  "description": "Bridges DeepSeek Harness activity, approvals, and questions to the At-Pet desktop pet",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "at-pet",
    "desktop-pet"
  ],
  "license": "MIT"
}
